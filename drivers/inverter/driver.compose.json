        "tokens": [
          {
            "id": "power",
            "type": "number",
            "title": {
              "en": "Current Power (W)",
              "nl": "Actueel vermogen (W)",
              "es": "Potencia actual (W)"
            }
          }
        ]
      },
      {
        "id": "today_yield_changed",
        "title": {
          "en": "Today yield changed",
          "nl": "Dagopbrengst is veranderd",
          "es": "La producción de hoy ha cambiado"
        },
        "tokens": [
          {
            "id": "yield",
            "type": "number",
            "title": {
              "en": "Yield Today (kWh)",
