{
  "name": {
    "en": "Elekeeper Inverter",
    "nl": "Elekeeper Omvormer",
    "es": "Inversor Elekeeper"
  },
  "class": "solarpanel",
  "platforms": [
    "local"
  ],
  "images": {
    "large": "/drivers/inverter/assets/images/large.png",
    "small": "/drivers/inverter/assets/images/small.png"
  },
  "capabilities": [
    "measure_power",
    "meter_power",
    "meter_power.today",
    "measure_battery",
    "measure_power.battery",
    "measure_power.grid",
    "measure_power.load",
    "meter_power.imported_today",
    "meter_power.exported_today"
  ],
  "capabilitiesOptions": {
    "meter_power": {
      "title": {
        "en": "Total yield",
        "nl": "Totale opbrengst",
        "es": "Producción total"
      }
    },
    "meter_power.today": {
      "title": {
        "en": "Yield today",
        "nl": "Opbrengst vandaag",
        "es": "Producción de hoy"
      }
    },
    "measure_battery": {
      "title": {
        "en": "Battery capacity",
        "nl": "Batterijniveau",
        "es": "Nivel de batería"
      }
    },
    "measure_power.battery": {
      "title": {
        "en": "Battery power",
        "nl": "Batterij vermogen",
        "es": "Potencia de la batería"
      }
    },
    "measure_power": {
      "title": {
        "en": "Solar power",
        "nl": "Zonnevermogen",
        "es": "Potencia solar"
      }
    },
    "measure_power.grid": {
      "title": {
        "en": "Grid power",
        "nl": "Netvermogen",
        "es": "Potencia de red"
      }
    },
    "measure_power.load": {
      "title": {
        "en": "Home consumption",
        "nl": "Huisverbruik",
        "es": "Consumo de la casa"
      }
    },
    "meter_power.imported_today": {
      "title": {
        "en": "Imported today",
        "nl": "Vandaag afgenomen",
        "es": "Importado hoy"
      }
    },
    "meter_power.exported_today": {
      "title": {
        "en": "Exported today",
        "nl": "Vandaag teruggeleverd",
        "es": "Exportado hoy"
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "power_changed",
        "title": {
          "en": "Power changed",
          "nl": "Vermogen is veranderd",
          "es": "La potencia ha cambiado"
        },
        "tokens": [
          {
            "id": "power",
            "type": "number",
            "title": {
              "en": "Current Power (W)",
              "nl": "Actueel vermogen (W)",
              "es": "Potencia actual (W)"
            }
          }
        ]
      },
      {
        "id": "today_yield_changed",
        "title": {
          "en": "Today yield changed",
          "nl": "Dagopbrengst is veranderd",
          "es": "La producción de hoy ha cambiado"
        },
        "tokens": [
          {
            "id": "yield",
            "type": "number",
            "title": {
              "en": "Yield Today (kWh)",
              "nl": "Dagopbrengst (kWh)",
              "es": "Producción de hoy (kWh)"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "power_greater_than",
        "title": {
          "en": "Solar production is greater than...",
          "nl": "Zonne-opbrengst is groter dan...",
          "es": "La producción solar es mayor que..."
        },
        "titleFormatted": {
          "en": "Solar production is greater than [[power]] W",
          "nl": "Zonne-opbrengst is groter dan [[power]] W",
          "es": "La producción solar es mayor que [[power]] W"
        },
        "args": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)",
              "es": "Potencia (W)"
            },
            "placeholder": "2000"
          }
        ]
      },
      {
        "id": "power_less_than",
        "title": {
          "en": "Solar production is less than...",
          "nl": "Zonne-opbrengst is lager dan...",
          "es": "La producción solar es menor que..."
        },
        "titleFormatted": {
          "en": "Solar production is less than [[power]] W",
          "nl": "Zonne-opbrengst is lager dan [[power]] W",
          "es": "La producción solar es menor que [[power]] W"
        },
        "args": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)",
              "es": "Potencia (W)"
            },
            "placeholder": "500"
          }
        ]
      },
      {
        "id": "battery_greater_than",
        "title": {
          "en": "Battery level is higher than...",
          "nl": "Batterijniveau is hoger dan...",
          "es": "El nivel de batería es superior a..."
        },
        "titleFormatted": {
          "en": "Battery level is higher than [[percentage]] %",
          "nl": "Batterijniveau is hoger dan [[percentage]] %",
          "es": "El nivel de batería es superior a [[percentage]] %"
        },
        "args": [
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)",
              "es": "Nivel (%)"
            },
            "placeholder": "90"
          }
        ]
      },
      {
        "id": "battery_less_than",
        "title": {
          "en": "Battery level is lower than...",
          "nl": "Batterijniveau is lager dan...",
          "es": "El nivel de batería es inferior a..."
        },
        "titleFormatted": {
          "en": "Battery level is lower than [[percentage]] %",
          "nl": "Batterijniveau is lager dan [[percentage]] %",
          "es": "El nivel de batería es inferior a [[percentage]] %"
        },
        "args": [
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)",
              "es": "Nivel (%)"
            },
            "placeholder": "80"
          }
        ]
      }
    ]
  },
  "energy": {
    "batteries": [
      "INTERNAL"
    ]
  },
  "settings": [
    {
      "id": "region",
      "type": "dropdown",
      "label": {
        "en": "Network node",
        "nl": "Netwerk node",
        "es": "Nodo de red"
      },
      "value": "europe",
      "values": [
        {
          "id": "europe",
          "label": {
            "en": "Europe",
            "nl": "Europa",
            "es": "Europa"
          }
        },
        {
          "id": "international",
          "label": {
            "en": "International (Other Countries)",
            "nl": "Internationaal (Andere landen)",
            "es": "Internacional (Otros países)"
          }
        }
      ],
      "hint": {
        "en": "Select the same node as in the Elekeeper app. Switching nodes signs in again. Existing devices keep Europe until changed.",
        "nl": "Selecteer dezelfde node als in de Elekeeper-app. Bij wijzigen wordt opnieuw ingelogd. Bestaande apparaten blijven op Europa.",
        "es": "Seleccione el mismo nodo que en Elekeeper. Cambiar el nodo inicia sesión de nuevo. Los dispositivos existentes mantienen Europa."
      }
    },
    {
      "id": "inverter_index",
      "type": "number",
      "label": {
        "en": "Inverter Index (0 = first, 1 = second)",
        "nl": "Omvormer Index (0 = eerste, 1 = tweede)",
        "es": "Índice del inversor (0 = primero, 1 = segundo)"
      },
      "value": 0,
      "hint": {
        "en": "If you have multiple inverters, change this number to select which one to display.",
        "nl": "Als je meerdere omvormers hebt, verander dit getal om te kiezen welke wordt getoond.",
        "es": "Si tienes varios inversores, cambia este número para elegir cuál se muestra."
      }
    }
  ]
}
