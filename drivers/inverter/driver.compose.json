          "es": "La producción solar es mayor que [[power]] W"
        },
        "args": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)",
              "es": "Potencia (W)"
            },
            "placeholder": "2000"
          }
        ]
      },
      {
        "id": "power_less_than",
        "title": {
          "en": "Solar production is less than...",
