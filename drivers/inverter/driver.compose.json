{
  "name": {
    "en": "Elekeeper Inverter",
    "nl": "Elekeeper Omvormer"
  },
  "class": "solarpanel",
  "platforms": [
    "local"
  ],
  "images": {
    "large": "/drivers/inverter/assets/images/large.png",
    "small": "/drivers/inverter/assets/images/small.png"
  },
  "capabilities": [
    "measure_power",
    "meter_power",
    "meter_power.today",
    "measure_battery",
    "measure_power.battery"
  ],
  "capabilitiesOptions": {
    "meter_power": {
      "title": {
        "en": "Total yield",
        "nl": "Totale opbrengst"
      }
    },
    "meter_power.today": {
      "title": {
        "en": "Yield today",
        "nl": "Opbrengst vandaag"
      }
    },
    "measure_battery": {
      "title": {
        "en": "Battery capacity",
        "nl": "Batterijniveau"
      }
    },
    "measure_power.battery": {
      "title": {
        "en": "Battery power",
        "nl": "Batterij vermogen"
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "power_changed",
        "title": {
          "en": "Power changed",
          "nl": "Vermogen is veranderd"
        },
        "tokens": [
          {
            "id": "power",
            "type": "number",
            "title": {
              "en": "Current Power (W)",
              "nl": "Actueel vermogen (W)"
            }
          }
        ]
      },
      {
        "id": "today_yield_changed",
        "title": {
          "en": "Today yield changed",
          "nl": "Dagopbrengst is veranderd"
        },
        "tokens": [
          {
            "id": "yield",
            "type": "number",
            "title": {
              "en": "Yield Today (kWh)",
              "nl": "Dagopbrengst (kWh)"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "power_greater_than",
        "title": {
          "en": "Solar production is greater than...",
          "nl": "Zonne-opbrengst is groter dan..."
        },
        "titleFormatted": {
          "en": "Solar production is greater than [[power]] W",
          "nl": "Zonne-opbrengst is groter dan [[power]] W"
        },
        "args": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)"
            },
            "placeholder": "2000"
          }
        ]
      },
      {
        "id": "power_less_than",
        "title": {
          "en": "Solar production is less than...",
          "nl": "Zonne-opbrengst is lager dan..."
        },
        "titleFormatted": {
          "en": "Solar production is less than [[power]] W",
          "nl": "Zonne-opbrengst is lager dan [[power]] W"
        },
        "args": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)"
            },
            "placeholder": "500"
          }
        ]
      },
      {
        "id": "battery_greater_than",
        "title": {
          "en": "Battery level is higher than...",
          "nl": "Batterijniveau is hoger dan..."
        },
        "titleFormatted": {
          "en": "Battery level is higher than [[percentage]] %",
          "nl": "Batterijniveau is hoger dan [[percentage]] %"
        },
        "args": [
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)"
            },
            "placeholder": "90"
          }
        ]
      },
      {
        "id": "battery_less_than",
        "title": {
          "en": "Battery level is lower than...",
          "nl": "Batterijniveau is lager dan..."
        },
        "titleFormatted": {
          "en": "Battery level is lower than [[percentage]] %",
          "nl": "Batterijniveau is lager dan [[percentage]] %"
        },
        "args": [
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)"
            },
            "placeholder": "80"
          }
        ]
      }
    ]
  },
  "energy": {
    "batteries": [
      "INTERNAL"
    ]
  }
}
