{
  "id": "be.telenut.elekeeper",
  "version": "1.3.6",
  "brandColor": "#3A3A3A",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "elekeeper"
  },
  "description": {
    "en": "Bring your SAJ eSolar inverter into Homey and automate your home with real-time solar data.",
    "nl": "Koppel je SAJ eSolar omvormer aan Homey en automatiseer je huis met realtime zonne-energie.",
    "es": "Conecta tu inversor SAJ eSolar a Homey y automatiza tu casa con datos solares en tiempo real."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "images": {
    "small": "assets/images/small.jpg",
    "large": "assets/images/large.jpg"
  },
  "author": {
    "name": "Steven Algoet",
    "email": "telenut@gmail.com"
  },
  "support": "https://community.homey.app/t/app-pro-elekeeper-saj-esolar-inverters/152892",
  "drivers": [
    {
      "id": "inverter",
      "name": {
        "en": "Elekeeper Inverter",
        "nl": "Elekeeper Omvormer",
        "es": "Inversor Elekeeper"
      },
      "class": "solarpanel",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_power",
        "meter_power",
        "meter_power.today",
        "measure_battery",
        "measure_power.battery",
        "measure_power.grid",
        "measure_power.load",
        "meter_power.imported_today",
        "meter_power.exported_today"
      ],
      "capabilitiesOptions": {
        "meter_power": {
          "title": {
            "en": "Total yield",
            "nl": "Totale opbrengst",
            "es": "Producción total"
          }
        },
        "meter_power.today": {
          "title": {
            "en": "Yield today",
            "nl": "Dagopbrengst",
            "es": "Producción de hoy"
          }
        },
        "measure_battery": {
          "title": {
            "en": "Battery capacity",
            "nl": "Batterijniveau",
            "es": "Nivel de batería"
          }
        },
        "measure_power.battery": {
          "title": {
            "en": "Battery power",
            "nl": "Batterij vermogen",
            "es": "Potencia de la batería"
          }
        },
        "measure_power": {
          "title": {
            "en": "Solar power",
            "nl": "Zonnevermogen",
            "es": "Potencia solar"
          }
        },
        "measure_power.grid": {
          "title": {
            "en": "Grid power",
            "nl": "Netvermogen",
            "es": "Potencia de red"
          }
        },
        "measure_power.load": {
          "title": {
            "en": "Home consumption",
            "nl": "Huisverbruik",
            "es": "Consumo de la casa"
          }
        },
        "meter_power.imported_today": {
          "title": {
            "en": "Imported today",
            "nl": "Vandaag afgenomen",
            "es": "Importado hoy"
          }
        },
        "meter_power.exported_today": {
          "title": {
            "en": "Exported today",
            "nl": "Vandaag teruggeleverd",
            "es": "Exportado hoy"
          }
        }
      },
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "pair": [
        {
          "id": "start"
        }
      ],
      "settings": [
        {
          "id": "inverter_index",
          "type": "number",
          "label": {
            "en": "Inverter Index (0 = first, 1 = second)",
            "nl": "Omvormer Index (0 = eerste, 1 = tweede)",
            "es": "Índice del inversor (0 = primero, 1 = segundo)"
          },
          "value": 0,
          "hint": {
            "en": "If you have multiple inverters, change this number to select which one to display.",
            "nl": "Als je meerdere omvormers hebt, verander dit getal om te kiezen welke wordt getoond.",
            "es": "Si tienes varios inversores, cambia este número para elegir cuál se muestra."
          }
        },
        {
          "id": "debug_logging",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Debug logging",
            "nl": "Debug-logging",
            "es": "Registro de depuración"
          },
          "hint": {
            "en": "Writes the raw Elekeeper responses to the app log. Useful when reporting a problem.",
            "nl": "Schrijft de ruwe Elekeeper-antwoorden naar het app-log. Handig bij het melden van een probleem.",
            "es": "Escribe las respuestas sin procesar de Elekeeper en el registro de la app. Útil al informar un problema."
          }
        }
      ],
      "images": {
        "small": "drivers/inverter/assets/images/small.png",
        "large": "drivers/inverter/assets/images/large.png"
      }
    },
    {
      "id": "battery",
      "name": {
        "en": "Elekeeper Battery",
        "nl": "Elekeeper Batterij",
        "es": "Batería Elekeeper"
      },
      "class": "battery",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_battery",
        "measure_power",
        "meter_power.charged",
        "meter_power.discharged",
        "meter_power.charged_today",
        "meter_power.discharged_today",
        "saj_operating_mode"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Battery power",
            "nl": "Batterijvermogen",
            "es": "Potencia de la batería"
          }
        },
        "meter_power.charged": {
          "title": {
            "en": "Total charged",
            "nl": "Totaal geladen",
            "es": "Total cargado"
          }
        },
        "meter_power.discharged": {
          "title": {
            "en": "Total discharged",
            "nl": "Totaal ontladen",
            "es": "Total descargado"
          }
        },
        "meter_power.charged_today": {
          "title": {
            "en": "Charged today",
            "nl": "Vandaag geladen",
            "es": "Cargado hoy"
          }
        },
        "meter_power.discharged_today": {
          "title": {
            "en": "Discharged today",
            "nl": "Vandaag ontladen",
            "es": "Descargado hoy"
          }
        }
      },
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
      },
      "images": {
        "large": "/drivers/battery/assets/images/large.png",
        "small": "/drivers/battery/assets/images/small.png"
      },
      "pair": [
        {
          "id": "start"
        }
      ],
      "settings": [
        {
          "id": "inverter_index",
          "type": "number",
          "value": 0,
          "min": 0,
          "label": {
            "en": "Inverter Index (0 = first, 1 = second)",
            "nl": "Omvormer Index (0 = eerste, 1 = tweede)",
            "es": "Índice del inversor (0 = primero, 1 = segundo)"
          },
          "hint": {
            "en": "The inverter the battery is connected to, if the plant has several.",
            "nl": "De omvormer waarop de batterij is aangesloten, als de installatie er meerdere heeft.",
            "es": "El inversor al que está conectada la batería, si la instalación tiene varios."
          }
        },
        {
          "id": "debug_logging",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Debug logging",
            "nl": "Debug-logging",
            "es": "Registro de depuración"
          },
          "hint": {
            "en": "Writes the raw Elekeeper responses to the app log. Useful when reporting a problem.",
            "nl": "Schrijft de ruwe Elekeeper-antwoorden naar het app-log. Handig bij het melden van een probleem.",
            "es": "Escribe las respuestas sin procesar de Elekeeper en el registro de la app. Útil al informar un problema."
          }
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "power_changed",
        "title": {
          "en": "Power changed",
          "nl": "Vermogen is veranderd",
          "es": "La potencia ha cambiado"
        },
        "tokens": [
          {
            "id": "power",
            "name": "power",
            "type": "number",
            "title": {
              "en": "Current Power",
              "nl": "Actueel vermogen",
              "es": "Potencia actual"
            }
          }
        ]
      },
      {
        "id": "today_yield_changed",
        "title": {
          "en": "Today yield changed",
          "nl": "Dagopbrengst is veranderd",
          "es": "La producción de hoy ha cambiado"
        },
        "tokens": [
          {
            "id": "yield",
            "name": "yield",
            "type": "number",
            "title": {
              "en": "Yield Today",
              "nl": "Dagopbrengst",
              "es": "Producción de hoy"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "power_greater_than",
        "title": {
          "en": "Solar production is greater than...",
          "nl": "Zonne-opbrengst is groter dan...",
          "es": "La producción solar es mayor que..."
        },
        "titleFormatted": {
          "en": "Solar production is greater than [[power]] W",
          "nl": "Zonne-opbrengst is groter dan [[power]] W",
          "es": "La producción solar es mayor que [[power]] W"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=inverter"
          },
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)",
              "es": "Potencia (W)"
            },
            "placeholder": "2000"
          }
        ]
      },
      {
        "id": "power_less_than",
        "title": {
          "en": "Solar production is less than...",
          "nl": "Zonne-opbrengst is lager dan...",
          "es": "La producción solar es menor que..."
        },
        "titleFormatted": {
          "en": "Solar production is less than [[power]] W",
          "nl": "Zonne-opbrengst is lager dan [[power]] W",
          "es": "La producción solar es menor que [[power]] W"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=inverter"
          },
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)",
              "es": "Potencia (W)"
            },
            "placeholder": "500"
          }
        ]
      },
      {
        "id": "battery_greater_than",
        "title": {
          "en": "Battery level is higher than...",
          "nl": "Batterijniveau is hoger dan...",
          "es": "El nivel de batería es superior a..."
        },
        "titleFormatted": {
          "en": "Battery level is higher than [[percentage]] %",
          "nl": "Batterijniveau is hoger dan [[percentage]] %",
          "es": "El nivel de batería es superior a [[percentage]] %"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=inverter"
          },
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)",
              "es": "Nivel (%)"
            },
            "placeholder": "90"
          }
        ]
      },
      {
        "id": "battery_less_than",
        "title": {
          "en": "Battery level is lower than...",
          "nl": "Batterijniveau is lager dan...",
          "es": "El nivel de batería es inferior a..."
        },
        "titleFormatted": {
          "en": "Battery level is lower than [[percentage]] %",
          "nl": "Batterijniveau is lager dan [[percentage]] %",
          "es": "El nivel de batería es inferior a [[percentage]] %"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=inverter"
          },
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": {
              "en": "Level (%)",
              "nl": "Niveau (%)",
              "es": "Nivel (%)"
            },
            "placeholder": "80"
          }
        ]
      }
    ]
  },
  "capabilities": {
    "saj_operating_mode": {
      "type": "string",
      "title": {
        "en": "Operating mode",
        "nl": "Werkingsmodus",
        "es": "Modo de funcionamiento"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/mode.svg",
      "insights": false
    }
  }
}
